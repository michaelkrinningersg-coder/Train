{
  "name": "rail-and-road",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @game/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "data:cities": "pnpm --filter @game/pipeline cities",
    "data:basemap": "pnpm --filter @game/pipeline basemap",
    "calibrate": "tsx tools/calibrate.ts"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@game/domain": "workspace:*",
    "@game/demand": "workspace:*",
    "@game/economy": "workspace:*",
    "@game/sim": "workspace:*",
    "@game/geo": "workspace:*",
    "tsx": "^4.20.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
