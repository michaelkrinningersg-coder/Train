{
  "name": "rail-and-road",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @game/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "typecheck:tools": "tsc --noEmit -p tools",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "pnpm typecheck && pnpm typecheck:tools && pnpm lint && pnpm test && pnpm build",
    "test": "pnpm -r test",
    "data:cities": "pnpm --filter @game/pipeline cities",
    "data:basemap": "pnpm --filter @game/pipeline basemap",
    "calibrate": "tsx tools/calibrate.ts",
    "data:terrain": "pnpm --filter @game/pipeline terrain",
    "data:facilities": "pnpm --filter @game/pipeline facilities",
    "data:osm": "pnpm --filter @game/pipeline osm"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@game/demand": "workspace:*",
    "@game/domain": "workspace:*",
    "@game/economy": "workspace:*",
    "@game/geo": "workspace:*",
    "@game/sim": "workspace:*",
    "@types/node": "^22.20.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
